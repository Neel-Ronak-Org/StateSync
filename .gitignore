# .gitignore for StateSync
# Never commit secrets or generated data to version control.

# Secrets
secrets/*
!secrets/README.md

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
.uv/
*.egg-info/
dist/
build/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Docker volumes (local dev)
postgres_data/
qdrant_data/
ollama_data/

# Logs
*.log
logs/

# OS
.DS_Store
Thumbs.db

# Real-data corpora. Never committed: 126MB, and CC BY-NC-SA licensed.
# Fetch with scripts/fetch_olist.sh; checksums are committed instead.
data/olist/
