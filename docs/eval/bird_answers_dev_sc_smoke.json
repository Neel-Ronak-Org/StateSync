   "executed_sql": "SELECT s.cdscode, s.school, s.charternum, t.avgscrwrite, RANK() OVER (ORDER BY t.avgscrwrite DESC) AS write_rank\nFROM cn_9240ceb08edb4938.satscores t\nJOIN cn_9240ceb08edb4938.schools s ON t.cds = s.cdscode\nWHERE t.avgscrwrite > 499\n  AND s.charternum IS NOT NULL\n  AND t.rtype = 'S'\nORDER BY t.avgscrwrite DESC",
